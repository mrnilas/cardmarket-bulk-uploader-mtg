{
  "name": "cardmarket-bulk-uploader-mtg",
  "description": "Browser extension to bulk-list Magic: The Gathering cards from a ManaBox CSV in your Cardmarket store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Niklas Jäger",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrnilas/cardmarket-bulk-uploader-mtg.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run compile && npm run lint && npm run test",
    "postinstall": "wxt prepare",
    "gen:expansions": "node scripts/generate-expansions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/papaparse": "^5.5.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "papaparse": "^5.7.0"
  }
}
